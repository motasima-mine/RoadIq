# ── AWS / Amazon Bedrock ───────────────────────────────────────────────────────
# server.py uses AWS_BEARER_TOKEN_BEDROCK (Bedrock API key), not IAM keys.
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=us-east-1

# Chat tab + quick replies default model (no inference profile required)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# /api/plan itinerary generation. Nova Pro for both tiers currently — Claude
# models need an Anthropic "model use case" form submitted in the Bedrock
# console first (account-level, one-time). Once approved, this can point to
# a "us.anthropic.claude-*" inference profile ID for stronger plan reasoning.
BEDROCK_PLAN_MODEL_ID=amazon.nova-pro-v1:0

# ── Databricks SQL Warehouse ──────────────────────────────────────────────────
DATABRICKS_HOST=pfj-sandbox-dev-east.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/2ff99aaeaf52a661
DATABRICKS_TOKEN=your_token_here

# ── Celonis (recommendation engine) ──────────────────────────────────────────
CELONIS_CLIENT_ID=your_client_id_here
CELONIS_CLIENT_SECRET=your_secret_here
CELONIS_TOKEN_URL=https://ai-context-model-pilot-pov.us-2.celonis.cloud/oauth2/token
